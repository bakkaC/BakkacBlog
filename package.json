{
  "name": "bakka",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm r2:assets && pnpm build:site",
    "build:site": "astro build",
    "preview": "astro preview",
    "check": "tsc --noEmit --runExternalCode",
    "deploy:pages": "pnpm r2:assets && pnpm check && pnpm build:site && wrangler pages deploy dist --project-name bakkac-blog --branch main",
    "publish:site": "pnpm deploy:pages",
    "r2:assets": "node scripts/r2-sync-assets.mjs",
    "r2:assets:dry": "node scripts/r2-sync-assets.mjs --dry-run"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/react": "^7.1.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@paper-design/shaders-react": "0.0.81",
    "astro": "^7.4.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.59.0",
    "lz-string": "^1.5.0",
    "matter-js": "^0.20.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "7.1.0-dev.20261018.1",
    "wrangler": "^4.151.1"
  }
}
