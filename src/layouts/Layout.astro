---
import '../styles/global.css';
import { formatSchemaDate } from '../lib/content-date';
import { withBase } from '../lib/site-taxonomy';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date | string;
  tags?: string[];
  noindex?: boolean;
  /** High-priority image URLs to preload (homepage LCP, etc.). */
  preloadImages?: string[];
}

const {
  title,
  description,
  canonical,
  image,
  ogType,
  publishedTime,
  tags,
  noindex,
  preloadImages = [],
} = Astro.props;

const normalizedTitle = typeof title === 'string' && title.trim().length ? title.trim() : undefined;
const normalizedDescription =
  typeof description === 'string' && description.trim().length
    ? description.trim()
    : undefined;
const siteName = "Bakkac's Blog";
const authorName = 'Bakkac';

const pageTitle = normalizedTitle ? `${normalizedTitle} | ${siteName}` : siteName;
const pageDescription =
  normalizedDescription ?? '记录技术成长、分享生活感悟、探索思维边界';
const baseUrl = import.meta.env.BASE_URL;
const withSiteBase = (path: string) => withBase(baseUrl, path);
const homeHref = withSiteBase('/');
const navAvatarSrc = withSiteBase('/kumiko-avatar.webp');

const canonicalUrl =
  canonical ??
  (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : Astro.url.toString());

// Social previews need something larger than the 128px nav avatar, so they use
// the favicon-sized illustration instead.
const ogImagePath = image ?? '/kumiko-favicon.png';
const ogImageUrl = Astro.site
  ? new URL(withSiteBase(ogImagePath), Astro.site).toString()
  : withSiteBase(ogImagePath);

const resolvedOgType = ogType ?? 'website';
const publishedISO = formatSchemaDate(publishedTime);
const rssUrl = Astro.site
  ? new URL(withSiteBase('/rss.xml'), Astro.site).toString()
  : withSiteBase('/rss.xml');

const identityUrl = Astro.site ? new URL(withSiteBase('/'), Astro.site).toString() : withSiteBase('/');
const websiteSchema = Astro.site
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: identityUrl,
      inLanguage: 'zh-Hans',
    }
  : undefined;

const pageSchema =
  resolvedOgType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: normalizedTitle ?? siteName,
        description: pageDescription,
        url: canonicalUrl,
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
        inLanguage: 'zh-Hans',
        ...(publishedISO ? { datePublished: publishedISO } : {}),
        ...(tags?.length ? { keywords: tags.join(', ') } : {}),
        image: [ogImageUrl],
        author: { '@type': 'Person', name: authorName, url: identityUrl },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: pageTitle,
        description: pageDescription,
        url: canonicalUrl,
        inLanguage: 'zh-Hans',
      };

const schemas = [websiteSchema, pageSchema].filter(Boolean);

const navCandidates = [
  { label: 'Notes', path: '/notes' },
  { label: 'Thoughts', path: '/thoughts' },
  { label: 'Posts', path: '/posts' },
];
const currentPath = Astro.url.pathname ?? '/';
const navLinks = navCandidates.map((link) => {
  const href = withSiteBase(link.path);
  const normalizedCurrent = currentPath.endsWith('/') && currentPath.length > 1
    ? currentPath.slice(0, -1)
    : currentPath;
  const normalizedHref = href.endsWith('/') && href.length > 1
    ? href.slice(0, -1)
    : href;
  const isActive =
    normalizedCurrent === normalizedHref ||
    normalizedCurrent.startsWith(`${normalizedHref}/`);
  return { ...link, href, isActive };
});
---

<!doctype html>
<html lang="zh-Hans" class="no-js bg-background text-foreground">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      {/*
        Critical first paint: grey sheet + spinner must not wait on the main
        stylesheet. The build rewrites the Tailwind `<link rel="stylesheet">`
        to `media="print" onload="this.media='all'"` so the browser can paint
        this inline CSS immediately instead of holding a white viewport for
        ~90KB of CSS. High-priority image preloads used to starve even that
        path and leave cold visits with no loader animation.
      */}
      <meta name="theme-color" content="#ececee" />
      <style is:inline>
        html,
        body {
          background: #ececee;
        }
        .boot-veil {
          position: fixed;
          inset: 0;
          z-index: 60;
          display: grid;
          place-items: center;
          pointer-events: none;
          contain: strict;
          background: #ececee;
          opacity: 1;
          transition: opacity 320ms ease-out;
        }
        .boot-veil[data-boot-veil-state='done'] {
          opacity: 0;
          visibility: hidden;
          transition: opacity 320ms ease-out, visibility 0s 320ms;
        }
        .boot-veil__grain {
          position: absolute;
          inset: 0;
          background-image: radial-gradient(rgba(0, 0, 0, 0.045) 1px, transparent 1px);
          background-size: 3px 3px;
          opacity: 0.7;
        }
        .boot-veil__spinner {
          position: relative;
          width: 10px;
          height: 10px;
          border-radius: 50%;
          background: rgb(0 0 0 / 0.55);
          animation: boot-veil-pulse 1.1s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        @keyframes boot-veil-pulse {
          0%,
          100% {
            transform: scale(0.72);
            opacity: 0.5;
          }
          50% {
            transform: scale(1.18);
            opacity: 1;
          }
        }
        .no-js .boot-veil {
          display: none;
        }
        @media (prefers-reduced-motion: reduce) {
          .boot-veil__spinner {
            animation: none;
          }
        }
      </style>
      <title>{pageTitle}</title>
      <meta name="description" content={pageDescription} />
      <meta name="author" content={authorName} />
      <meta
        name="robots"
        content={noindex ? 'noindex, nofollow' : 'index, follow'}
      />
      <link rel="canonical" href={canonicalUrl} />

      <meta property="og:title" content={pageTitle} />
      <meta property="og:description" content={pageDescription} />
      <meta property="og:type" content={resolvedOgType} />
      <meta property="og:url" content={canonicalUrl} />
      <meta property="og:site_name" content={siteName} />
      <meta property="og:locale" content="zh_CN" />
      <meta property="og:image" content={ogImageUrl} />

      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={pageTitle} />
      <meta name="twitter:description" content={pageDescription} />
      <meta name="twitter:image" content={ogImageUrl} />

      {resolvedOgType === 'article' && publishedISO ? (
        <meta property="article:published_time" content={publishedISO} />
      ) : null}
      {resolvedOgType === 'article' && tags?.length
        ? tags.map((tag) => <meta property="article:tag" content={tag} />)
        : null}

      <link
        rel="alternate"
        type="application/rss+xml"
        title={`${siteName} RSS`}
        href={rssUrl}
      />

      <script
        type="application/ld+json"
        set:html={JSON.stringify(schemas)}
        is:inline
      />
      {/*
        Both faces are self-hosted (same origin, so no DNS/TLS round trip to a
        third party) and preloaded at high priority. `font-display: swap` lives
        in the `@font-face` rules in `global.css`, so text paints immediately in
        the fallback and swaps when the face arrives.

        Only Outfit's `latin` slice is preloaded; its `latin-ext` slice and the
        system CJK fallback are left to the CSS `unicode-range` checks so we
        never preload a file the current page cannot use.
      */}
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href={withSiteBase('/fonts/din-2014.woff2')}
        crossorigin
      />
      <link
        rel="preload"
        as="font"
        type="font/woff2"
        href={withSiteBase('/fonts/outfit-latin.woff2')}
        crossorigin
      />
      {/*
        Optional image preloads must stay low-priority. `fetchpriority=high`
        on ~1MB of homepage art starved CSS/JS and blocked the loader itself.
        Prefer discovering `img[data-boot-critical]` under the veil instead.
      */}
      {preloadImages.map((href) => (
        <link rel="preload" as="image" href={href} fetchpriority="low" />
      ))}
      <link rel="icon" type="image/png" href={withSiteBase('/kumiko-favicon.png')} />
      {navLinks.map((link) => (
        <link rel="prefetch" href={link.href} />
      ))}

      {/*
        Warm the shader bundle after fonts/LCP images. Prefetch (not
        modulepreload) so it does not compete with the homepage hero on the
        critical path; collection pages still discover it before navigation
        settles. Placeholder is rewritten at build time only — skip in DEV or
        the browser 404s `/__PAPER_TEXTURE_CHUNK__` and can poison Vite deps.
      */}
      {import.meta.env.PROD ? (
        <link rel="prefetch" as="script" href="/__PAPER_TEXTURE_CHUNK__" />
      ) : null}
      {/*
        Show the veil immediately, and arm a hard ceiling before the module
        boot script even downloads — otherwise a stalled bundle leaves the
        visitor on an endless grey load with no way out.
      */}
      <script is:inline>
        document.documentElement.classList.remove('no-js');
        window.setTimeout(function () {
          var veil = document.querySelector('.boot-veil');
          if (!veil || veil.getAttribute('data-boot-veil-state') === 'done') return;
          veil.setAttribute('data-boot-veil-state', 'done');
          document.dispatchEvent(new CustomEvent('bakkac:boot-ready'));
          window.setTimeout(function () {
            veil.remove();
          }, 360);
        }, 4000);
      </script>
      <script>
        import { dismissBootVeil } from '../lib/boot-veil';
        dismissBootVeil();
      </script>
    </head>
    <body class="min-h-screen bg-background text-foreground">
      <div class="boot-veil" data-boot-veil-state="idle" aria-hidden="true">
        <div class="boot-veil__grain"></div>
        <div class="boot-veil__spinner"></div>
      </div>
      <header class="sticky top-0 z-50 bg-background/80 backdrop-blur">
        <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-4">
          <a href={homeHref} class="inline-flex items-center gap-3 font-sans text-base font-bold sm:text-lg">
            <img
              src={navAvatarSrc}
              alt=""
              aria-hidden="true"
              class="h-8 w-8 rounded-full object-cover ring-1 ring-slate-200"
            />
            <span>{siteName}</span>
          </a>
          <nav class="font-sans flex items-center gap-6 text-xs font-medium md:text-sm">
            {navLinks.map((link) => (
              <a
                class="font-medium hover:text-primary"
                href={link.href}
                rel="prefetch"
                aria-current={link.isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      </header>
    <main class="min-h-[calc(100vh-80px)]">
      <slot />
    </main>
  </body>
</html>
