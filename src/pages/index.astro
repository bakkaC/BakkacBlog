---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/Layout.astro';
import HomePage from '../components/pages/HomePage';
import { formatContentDate, formatDottedDate } from '../lib/content-date';
import {
  COLLECTION_ROOTS,
  collectTagBuckets,
  normalizeTag,
  sortEntriesByDate,
  withBase,
  type SiteEntry,
} from '../lib/site-taxonomy';
import type { HomeAccordionLatest } from '../components/home/types';

const baseUrl = import.meta.env.BASE_URL;
const [notes, thoughts, posts] = await Promise.all([
  getCollection('notes'),
  getCollection('thoughts'),
  getCollection('posts'),
]);

const entries = sortEntriesByDate([...notes, ...thoughts, ...posts]);
const tagBuckets = collectTagBuckets(entries);

const latestPosts = entries.slice(0, 5).map((entry) => ({
  title: entry.data.title ?? entry.id,
  href: withBase(baseUrl, `${COLLECTION_ROOTS[entry.collection]}/${entry.id}`),
  dateLabel: formatContentDate(entry.data.date),
  collection: entry.collection,
  tags: [...new Set((entry.data.tags ?? []).map(normalizeTag).filter(Boolean))],
}));

const toAccordionLatest = (collectionEntries: SiteEntry[]): HomeAccordionLatest | null => {
  const [latest] = sortEntriesByDate(collectionEntries);
  if (!latest) return null;
  return {
    title: latest.data.title ?? latest.id,
    href: withBase(baseUrl, `${COLLECTION_ROOTS[latest.collection]}/${latest.id}`),
    dateLabel: formatDottedDate(latest.data.date),
    tags: [...new Set((latest.data.tags ?? []).map(normalizeTag).filter(Boolean))],
  };
};

const accordionLatest = {
  notes: toAccordionLatest(notes),
  thoughts: toAccordionLatest(thoughts),
  posts: toAccordionLatest(posts),
};

const categories = tagBuckets.slice(0, 28).map((bucket) => ({
  tag: bucket.tag,
  count: bucket.count,
  href: withBase(baseUrl, `/tag/${bucket.slug}`),
}));
---

<BaseLayout>
  <HomePage
    baseUrl={baseUrl}
    latestPosts={latestPosts}
    accordionLatest={accordionLatest}
    categories={categories}
    client:load
  />
</BaseLayout>
