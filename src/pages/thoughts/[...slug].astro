---
import BaseLayout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import EntryTags from '../../components/collection/EntryTags.astro';
import { mdxComponents } from '../../components/content/mdx-components';
import { formatContentDate } from '../../lib/content-date';
import ArticleToc from '../../components/content/ArticleToc.astro';

export async function getStaticPaths() {
  const entries = await getCollection('thoughts');
  return entries.map((entry) => ({
    params: { slug: entry.id },
  }));
}

const { slug } = Astro.params;
const entries = await getCollection('thoughts');
const entry = entries.find((item) => item.id === slug);
if (!entry) {
  throw new Error(`Thought not found: ${slug}`);
}

const { Content, headings } = await render(entry);
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title={entry.data.title ?? entry.id}
  description={entry.data.description}
  ogType="article"
  publishedTime={entry.data.date}
  tags={entry.data.tags}
>
  <div class="mx-auto w-full max-w-[96rem] px-6 py-12 2xl:grid 2xl:grid-cols-[15rem_minmax(0,56rem)_15rem] 2xl:justify-center 2xl:gap-8">
    <div class="hidden 2xl:block" aria-hidden="true"></div>
    <article class="min-w-0 w-full max-w-4xl justify-self-center">
      <div class="mb-8">
        <h1 class="text-3xl font-bold">
          {entry.data.title ?? entry.id}
        </h1>
        {entry.data.date ? (
          <p class="mt-2 text-sm text-muted-foreground">
            {formatContentDate(entry.data.date)}
          </p>
        ) : null}
        {entry.data.tags?.length ? (
          <EntryTags tags={entry.data.tags} className="mt-4" baseUrl={baseUrl} />
        ) : null}
      </div>
      <ArticleToc headings={headings} variant="mobile" />
      <div class="markdown">
        <Content components={mdxComponents} />
      </div>
    </article>
    <ArticleToc headings={headings} variant="desktop" />
  </div>
</BaseLayout>
